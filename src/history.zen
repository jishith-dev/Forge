import (headId, commitFile, readCommit, shortId, yellow) from "util.zen"

// Walk the parent chain from the newest commit back to the first one.
fn showLog(bool brief) void {
    string id = headId()
    if (id == "") {
        screen("No commits yet")
        return
    }

    while (id != "none") {
        if (!fs.isFile(commitFile(id))) {
            screen("Error: commit " + id + " is missing")
            return
        }

        List<string> c = readCommit(id)

        if (brief) {
            screen(yellow(shortId(id)) + " " + c[4])
        } else {
            screen(yellow("commit " + id))
            screen("Author: " + c[2])
            screen("Date:   " + c[3])
            screen("")
            screen("    " + c[4])
            screen("")
        }

        id = c[1]
    }
}

export (showLog)
